services:

  #PHP Service
  provision-provider-ssl:
    build:
      context: .
      dockerfile: ./.docker/Dockerfile
    container_name: provision-provider-ssl
    tty: true
    environment:
      SERVICE_NAME: provision-provider-ssl
      SERVICE_TAGS: dev
    working_dir: /usr/src/lib
    volumes:
      - ./:/usr/src/lib
    networks:
      - provision-provider-ssl-network

#Docker Networks
networks:
  provision-provider-ssl-network:
    driver: bridge
